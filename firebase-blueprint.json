{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "An application submitted by a client",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "incidentDate": {
          "type": "string"
        },
        "incidentDescription": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "urgency": {
          "type": "string",
          "enum": ["YUKSAK", "O'RTA", "PAST"]
        },
        "status": {
          "type": "string",
          "enum": ["YANGI", "KO'RIB_CHIQILMOQDA", "QABUL_QILINGAN", "RAD_ETILGAN"]
        },
        "createdAt": {
          "type": "string"
        },
        "injuries": {
          "type": "string"
        },
        "fault": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "assignedLawyer": {
          "type": "string"
        },
        "deadline": {
          "type": "string"
        }
      },
      "required": ["id", "fullName", "phone", "incidentDescription", "status", "urgency", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile with Google auth details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ism": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "rasm": {
          "type": "string"
        },
        "sana": {
          "type": "string"
        }
      },
      "required": ["id", "ism", "email"]
    },
    "RegisteredUser": {
      "title": "RegisteredUser",
      "description": "A registered user in the system",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ism": {
          "type": "string"
        },
        "telefon": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "manzil": {
          "type": "string"
        },
        "parol": {
          "type": "string"
        },
        "rasm": {
          "type": "string"
        },
        "sana": {
          "type": "string"
        },
        "subscriptionTier": {
          "type": "string",
          "enum": ["free", "premium"]
        },
        "subscriptionExpiresAt": {
          "type": "string"
        },
        "activeCaseLimit": {
          "type": "number"
        }
      },
      "required": ["id", "ism", "email"]
    },
    "Payment": {
      "title": "Payment",
      "description": "A subscription payment document for Payme/Click integrations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "lawyerId": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "provider": {
          "type": "string",
          "enum": ["payme", "click"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "failed"]
        },
        "transactionId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        }
      },
      "required": ["id", "lawyerId", "amount", "provider", "status", "transactionId", "createdAt"]
    },
    "FeatureSettings": {
      "title": "FeatureSettings",
      "description": "Application feature toggles",
      "type": "object",
      "properties": {
        "lawyerHiring": {
          "type": "boolean"
        },
        "policeComplaint": {
          "type": "boolean"
        },
        "witnesses": {
          "type": "boolean"
        },
        "news": {
          "type": "boolean"
        }
      },
      "required": ["lawyerHiring", "policeComplaint", "witnesses", "news"]
    }
  },
  "firestore": {
    "applications": {
      "schema": "Application",
      "description": "User applications/submissions"
    },
    "users": {
      "schema": "User",
      "description": "Google auth and basic user profiles"
    },
    "user_profiles": {
      "schema": "RegisteredUser",
      "description": "Registered user profiles"
    },
    "settings": {
      "schema": "FeatureSettings",
      "description": "Feature toggles and app configurations"
    },
    "payments": {
      "schema": "Payment",
      "description": "Payment transactions for subscription plans"
    }
  }
}
